@@ -0,0 +1,38 @@
+import math
+from collections.abc import Mapping
+from dataclasses import dataclass
+
+from schemas.query import QueryValidationError, SkyImageQuery, parse_sky_image_query
+
+
+@dataclass(frozen=True)
+class ChunkSpectrumQuery:
+    """A click on the rendered frame, as a fraction of the image width/height.
+
+    ``x`` grows left to right and ``y`` grows top to bottom, both in [0, 1].
+    """
+
+    sky: SkyImageQuery
+    x: float
+    y: float
+
+
+def _parse_fraction(args: Mapping[str, str], name: str) -> float:
+    raw = (args.get(name) or "").strip()
+    if not raw:
+        raise QueryValidationError(f"'{name}' is required.")
+    try:
+        value = float(raw)
+    except ValueError:
+        raise QueryValidationError(f"'{name}' must be a number between 0 and 1.") from None
+    if not math.isfinite(value) or not 0.0 <= value <= 1.0:
+        raise QueryValidationError(f"'{name}' must be a number between 0 and 1.")
+    return value
+
+
+def parse_chunk_spectrum_query(args: Mapping[str, str]) -> ChunkSpectrumQuery:
+    return ChunkSpectrumQuery(
+        sky=parse_sky_image_query(args),
+        x=_parse_fraction(args, "x"),
+        y=_parse_fraction(args, "y"),
+    )
diff --git a/backend/services/hips_cube.py b/backend/services/hips_cube.py
new file mode 100644
index 0000000..dd65832
--- /dev/null
+++ b/backend/services/hips_cube.py
@@ -0,0 +1,237 @@
+"""Read small sky regions out of the SPHEREx DR1 HiPS FITS cubes.
+
+Each HEALPix order-5 tile is a ~300 MB MEF file whose IMAGE extension is a
+102 x 512 x 512 cube (MJy/sr, 12.9"/px, HPX projection). A chunk spectrum only
+needs a few dozen pixels, so instead of downloading the whole tile we walk the
+FITS headers and fetch just the rows we need from every layer with HTTP Range
+requests, in parallel. If the server ignores Range, we fall back to downloading
+the tile once into astropy's on-disk cache and reading it locally.
+"""
+
+import io
+import math
+import os
+import re
+from collections.abc import Callable
+from concurrent.futures import ThreadPoolExecutor
+from dataclasses import dataclass
+
+import astropy.units as u
+import hpgeom
+import numpy as np
+import requests
+from astropy.coordinates import SkyCoord
+from astropy.io import fits
+from astropy.table import Table
+from astropy.utils.data import download_file
+from astropy.wcs import WCS
+
+HIPS_CUBE_DATA_URL = os.environ.get(
+    "SPHEREX_HIPS_CUBE_URL",
+    "https://irsa.ipac.caltech.edu/ibe/data/spherex/dr1/hips5_cube/hips_20261026",
+)
+HIPS_ORDER = 5
+FITS_BLOCK = 2880
+CARD = 80
+HEADER_PROBE_BYTES = 10 * FITS_BLOCK
+MAX_HDUS = 16
+MAX_PARALLEL_RANGES = 16
+HTTP_TIMEOUT_S = 60
+
+_BITPIX_DTYPES = {8: ">u1", 16: ">i2", 32: ">i4", 64: ">i8", -32: ">f4", -64: ">f8"}
+_CELESTIAL_EXTRA_KEYS = ("LONPOLE", "LATPOLE", "RADESYS", "EQUINOX", "MJD-OBS", "DATE-OBS")
+
+# (url, first_byte, last_byte_inclusive) -> bytes
+RangeFetcher = Callable[[str, int, int], bytes]
+
+
+class RangeNotSupportedError(Exception):
+    pass
+
+
+class OutsideTileError(Exception):
+    pass
+
+
+@dataclass(frozen=True)
+class HduInfo:
+    header: fits.Header
+    header_offset: int
+    data_offset: int
+    raw_header: bytes
+
+
+@dataclass(frozen=True)
+class FieldCube:
+    data: np.ndarray  # (n_channels, ny, nx), MJy/sr, NaN where there is no coverage
+    wcs: WCS  # 2D celestial WCS of ``data``'s spatial axes
+    wavelength_um: np.ndarray
+    bandwidth_um: np.ndarray
+    unit: str
+
+
+def tile_url(ra_deg: float, dec_deg: float, order: int = HIPS_ORDER) -> str:
+    ipix = int(hpgeom.angle_to_pixel(2**order, ra_deg, dec_deg, nest=True, lonlat=True))
+    dir_id = (ipix // 10000) * 10000
+    return f"{HIPS_CUBE_DATA_URL}/Norder{order}/Dir{dir_id}/Npix{ipix}_cube.fits"
+
+
+_session = requests.Session()
+
+
+def http_range_fetch(url: str, start: int, end: int) -> bytes:
+    resp = _session.get(url, headers={"Range": f"bytes={start}-{end}"}, timeout=HTTP_TIMEOUT_S)
+    if resp.status_code == 200:
+        raise RangeNotSupportedError(url)
+    if resp.status_code == 416:  # asked past the end of the file
+        return b""
+    resp.raise_for_status()
+    return resp.content
+
+
+def file_range_fetch(url: str, start: int, end: int) -> bytes:
+    with open(url, "rb") as fh:
+        fh.seek(start)
+        return fh.read(end - start + 1)
+
+
+def _read_header(url: str, fetch: RangeFetcher, offset: int) -> tuple[fits.Header, bytes]:
+    buf = b""
+    while True:
+        chunk = fetch(url, offset + len(buf), offset + len(buf) + HEADER_PROBE_BYTES - 1)
+        if not chunk:
+            raise OSError("Unexpected end of FITS file while reading a header.")
+        scan_from = (len(buf) // CARD) * CARD
+        buf += chunk
+        for pos in range(scan_from, len(buf) - CARD + 1, CARD):
+            card = buf[pos : pos + CARD]
+            if card[:3] == b"END" and not card[3:].strip():
+                header_len = math.ceil((pos + CARD) / FITS_BLOCK) * FITS_BLOCK
+                raw = buf[:header_len]
+                return fits.Header.fromstring(raw[: pos + CARD].decode("ascii")), raw
+
+
+def _data_size(header: fits.Header) -> int:
+    naxis = int(header.get("NAXIS", 0))
+    if naxis == 0:
+        return 0
+    elements = math.prod(int(header[f"NAXIS{i}"]) for i in range(1, naxis + 1))
+    size = abs(int(header["BITPIX"])) // 8 * int(header.get("GCOUNT", 1)) * (
+        int(header.get("PCOUNT", 0)) + elements
+    )
+    return math.ceil(size / FITS_BLOCK) * FITS_BLOCK
+
+
+def scan_hdus(url: str, fetch: RangeFetcher, wanted: set[str]) -> dict[str, HduInfo]:
+    """Walk the MEF headers (skipping data) until every extension in ``wanted`` is found."""
+    found: dict[str, HduInfo] = {}
+    offset = 0
+    for index in range(MAX_HDUS):
+        header, raw = _read_header(url, fetch, offset)
+        name = str(header.get("EXTNAME", "PRIMARY" if index == 0 else "")).strip().upper()
+        data_offset = offset + len(raw)
+        if name in wanted:
+            found[name] = HduInfo(header, offset, data_offset, raw)
+            if wanted <= found.keys():
+                return found
+        offset = data_offset + _data_size(header)
+    raise OSError(f"FITS file is missing extensions: {sorted(wanted - found.keys())}")
+
+
+def read_cube_rows(
+    url: str, fetch: RangeFetcher, info: HduInfo, y0: int, y1: int, x0: int, x1: int
+) -> np.ndarray:
+    """Return ``cube[:, y0:y1, x0:x1]`` reading one contiguous byte range per layer."""
+    hdr = info.header
+    nx, ny, nz = int(hdr["NAXIS1"]), int(hdr["NAXIS2"]), int(hdr["NAXIS3"])
+    dtype = np.dtype(_BITPIX_DTYPES[int(hdr["BITPIX"])])
+    row_bytes = nx * dtype.itemsize
+    nrows = y1 - y0
+
+    def fetch_layer(k: int) -> np.ndarray:
+        start = info.data_offset + (k * ny + y0) * row_bytes
+        raw = fetch(url, start, start + nrows * row_bytes - 1)
+        if len(raw) != nrows * row_bytes:
+            raise OSError("Short read from the HiPS cube.")
+        return np.frombuffer(raw, dtype=dtype).reshape(nrows, nx)[:, x0:x1]
+
+    with ThreadPoolExecutor(max_workers=MAX_PARALLEL_RANGES) as pool:
+        layers = list(pool.map(fetch_layer, range(nz)))
+    cube = np.stack(layers).astype(np.float32)
+    bscale, bzero = float(hdr.get("BSCALE", 1.0)), float(hdr.get("BZERO", 0.0))
+    if bscale != 1.0 or bzero != 0.0:
+        cube = cube * bscale + bzero
+    return cube
+
+
+def read_table(url: str, fetch: RangeFetcher, info: HduInfo) -> Table:
+    size = _data_size(info.header)
+    data = fetch(url, info.data_offset, info.data_offset + size - 1) if size else b""
+    primary = io.BytesIO()
+    fits.PrimaryHDU().writeto(primary)
+    with fits.open(io.BytesIO(primary.getvalue() + info.raw_header + data)) as hdul:
+        return Table(hdul[1].data)
+
+
+def celestial_wcs(header: fits.Header) -> WCS:
+    """2D sky WCS from a cube header, ignoring the -TAB spectral axes (no fobj needed)."""
+    out = fits.Header()
+    out["NAXIS"] = 2
+    for key in header:
+        if re.fullmatch(r"(CTYPE|CRPIX|CRVAL|CDELT|CUNIT|NAXIS)[12]", key) or re.fullmatch(
+            r"(PC|CD)[12]_[12]|PV[12]_\d+", key
+        ):
+            out[key] = header[key]
+    for key in _CELESTIAL_EXTRA_KEYS:
+        if key in header:
+            out[key] = header[key]
+    return WCS(out)
+
+
+def local_pixel_scale_deg(wcs: WCS, x: float, y: float) -> float:
+    """sqrt of the on-sky solid angle of one pixel; correct for HPX, which is not to scale."""
+    c0, c1, c2 = wcs.pixel_to_world([x, x + 1, x], [y, y, y + 1])
+    dlon1, dlat1 = c0.spherical_offsets_to(c1)
+    dlon2, dlat2 = c0.spherical_offsets_to(c2)
+    area = np.abs(dlon1.deg * dlat2.deg - dlat1.deg * dlon2.deg)
+    return float(np.sqrt(area))
+
+
+def _load_field_cube(url: str, fetch: RangeFetcher, center: SkyCoord, half_size_deg: float) -> FieldCube:
+    hdus = scan_hdus(url, fetch, {"IMAGE", "SPECTRAL_CHANNELS"})
+    image = hdus["IMAGE"]
+    wcs = celestial_wcs(image.header)
+    nx, ny = int(image.header["NAXIS1"]), int(image.header["NAXIS2"])
+
+    x, y = (float(v) for v in wcs.world_to_pixel(center))
+    if not (np.isfinite(x) and np.isfinite(y) and -0.5 <= x < nx - 0.5 and -0.5 <= y < ny - 0.5):
+        raise OutsideTileError("The field center is not inside the HiPS tile.")
+
+    half_px = math.ceil(half_size_deg / local_pixel_scale_deg(wcs, x, y)) + 2
+    x0, x1 = max(0, round(x) - half_px), min(nx, round(x) + half_px + 1)
+    y0, y1 = max(0, round(y) - half_px), min(ny, round(y) + half_px + 1)
+
+    data = read_cube_rows(url, fetch, image, y0, y1, x0, x1)
+    channels = read_table(url, fetch, hdus["SPECTRAL_CHANNELS"])
+    return FieldCube(
+        data=data,
+        wcs=wcs.slice((slice(y0, y1), slice(x0, x1))),
+        wavelength_um=np.asarray(channels["WAVELENGTH"], dtype=float),
+        bandwidth_um=np.asarray(channels["BANDWIDTH"], dtype=float),
+        unit=str(image.header.get("BUNIT", "MJy/sr")).strip() or "MJy/sr",
+    )
+
+
+def load_field_cube(
+    ra_deg: float, dec_deg: float, half_size_deg: float, fetch: RangeFetcher | None = None
+) -> FieldCube:
+    """Spectral cube cut around (ra, dec), reading as little of the tile as possible."""
+    url = tile_url(ra_deg, dec_deg)
+    center = SkyCoord(ra_deg * u.deg, dec_deg * u.deg, frame="icrs")
+    if fetch is not None:
+        return _load_field_cube(url, fetch, center, half_size_deg)
+    try:
+        return _load_field_cube(url, http_range_fetch, center, half_size_deg)
+    except RangeNotSupportedError:
+        local_path = download_file(url, cache=True, timeout=HTTP_TIMEOUT_S * 10)
+        return _load_field_cube(local_path, file_range_fetch, center, half_size_deg)
diff --git a/backend/services/spectrum_service.py b/backend/services/spectrum_service.py
new file mode 100644
index 0000000..259af52
--- /dev/null
+++ b/backend/services/spectrum_service.py
@@ -0,0 +1,190 @@
+"""Quick-look spectrum (flux vs wavelength) for one chunk of the rendered frame.
+
+The frame the user sees is a single SPHEREx L2 cutout in detector orientation,
+so a chunk is defined in that image: a click (x, y as fractions of the image)
+selects a cell of an invisible grid whose cells are ~CHUNK_ARCSEC on a side.
+The chunk's corners go through the frame's WCS to the sky, and from the sky
+into the SPHEREx DR1 HiPS cube (102 channels, all-mission mosaic), where the
+pixels inside the chunk are averaged per channel.
+
+The HiPS cube is meant for visualization; for science use the IRSA SPHEREx
+spectrophotometry tool.
+"""
+
+import math
+import os
+import warnings
+from dataclasses import dataclass
+from datetime import date
+
+import numpy as np
+import requests
+from astropy.wcs import WCS
+from astropy.wcs.utils import proj_plane_pixel_scales
+from matplotlib.path import Path
+
+from services import hips_cube
+from services.cache import TTLCache
+from services.frames_service import _find_image_url
+from services.image_renderer import _download_fits_image
+from services.irsa_archive import ArchiveUnavailableError
+
+CHUNK_ARCSEC = float(os.environ.get("SPECTRUM_CHUNK_ARCSEC", "26"))  # ~2 HiPS cube pixels
+MAX_GRID = 32
+SPECTRUM_SOURCE = "SPHEREx DR1 HiPS cube (all-mission mosaic, quick-look)"
+
+FRAME_GEOMETRY_CACHE = TTLCache(ttl_s=3600, max_items=64)
+FIELD_CUBE_CACHE = TTLCache(ttl_s=3600, max_items=16)
+
+
+class SpectrumUnavailableError(Exception):
+    pass
+
+
+@dataclass(frozen=True)
+class FrameGeometry:
+    wcs: WCS  # celestial WCS of the rendered cutout
+    shape: tuple[int, int]  # (ny, nx) of the rendered cutout
+
+
+@dataclass(frozen=True)
+class ChunkGrid:
+    rows: int
+    cols: int
+    chunk_arcsec: float
+
+
+def get_frame_geometry(
+    ra_deg: float, dec_deg: float, observation_date: date, size_deg: float
+) -> FrameGeometry:
+    """WCS and shape of the same cutout that /api/frames/image renders."""
+
+    def compute():
+        fits_url = _find_image_url(ra_deg, dec_deg, observation_date)
+        try:
+            data, wcs = _download_fits_image(fits_url, ra_deg, dec_deg, size_deg)
+        except OSError as exc:
+            raise ArchiveUnavailableError("Image download failed.") from exc
+        if not wcs.has_celestial:
+            raise SpectrumUnavailableError("The frame has no sky coordinates.")
+        return FrameGeometry(wcs.celestial, tuple(int(n) for n in data.shape[-2:]))
+
+    key = (round(ra_deg, 5), round(dec_deg, 5), observation_date, size_deg)
+    return FRAME_GEOMETRY_CACHE.get_or_compute(key, compute)
+
+
+def get_field_cube(ra_deg: float, dec_deg: float, size_deg: float) -> hips_cube.FieldCube:
+    # A rotated square of side s fits in a circle of radius s/sqrt(2); add margin.
+    half_size_deg = size_deg * 0.75
+
+    def compute():
+        try:
+            return hips_cube.load_field_cube(ra_deg, dec_deg, half_size_deg)
+        except hips_cube.OutsideTileError as exc:
+            raise SpectrumUnavailableError("No SPHEREx mosaic tile covers this field.") from exc
+        except (OSError, requests.RequestException) as exc:
+            raise ArchiveUnavailableError("Spectral cube download failed.") from exc
+
+    key = (round(ra_deg, 5), round(dec_deg, 5), size_deg)
+    return FIELD_CUBE_CACHE.get_or_compute(key, compute)
+
+
+def chunk_grid(geometry: FrameGeometry, chunk_arcsec: float = CHUNK_ARCSEC) -> ChunkGrid:
+    ny, nx = geometry.shape
+    sx, sy = (float(s) * 3600 for s in proj_plane_pixel_scales(geometry.wcs))
+    cols = min(MAX_GRID, max(1, round(nx * sx / chunk_arcsec)))
+    rows = min(MAX_GRID, max(1, round(ny * sy / chunk_arcsec)))
+    return ChunkGrid(rows, cols, (nx * sx / cols + ny * sy / rows) / 2)
+
+
+def chunk_at(x: float, y: float, grid: ChunkGrid) -> tuple[int, int]:
+    """(row, col) of the chunk under a click; row 0 is the top of the image."""
+    return min(int(y * grid.rows), grid.rows - 1), min(int(x * grid.cols), grid.cols - 1)
+
+
+def chunk_corners_pixels(
+    row: int, col: int, grid: ChunkGrid, shape: tuple[int, int]
+) -> tuple[np.ndarray, np.ndarray]:
+    """Chunk corners in 0-based FITS pixels of the cutout.
+
+    The PNG is drawn with origin="lower" over [-0.5, n - 0.5], so the top of the
+    image is FITS y = ny - 0.5.
+    """
+    ny, nx = shape
+    left = -0.5 + col * nx / grid.cols
+    right = -0.5 + (col + 1) * nx / grid.cols
+    top = ny - 0.5 - row * ny / grid.rows
+    bottom = ny - 0.5 - (row + 1) * ny / grid.rows
+    return np.array([left, right, right, left]), np.array([top, top, bottom, bottom])
+
+
+def _chunk_pixel_mask(cube: hips_cube.FieldCube, corners_sky, center_sky) -> np.ndarray:
+    _, ny, nx = cube.data.shape
+    cx, cy = cube.wcs.world_to_pixel(corners_sky)
+    polygon = Path(np.column_stack([cx, cy]))
+    yy, xx = np.mgrid[0:ny, 0:nx]
+    mask = polygon.contains_points(np.column_stack([xx.ravel(), yy.ravel()])).reshape(ny, nx)
+    if mask.any():
+        return mask
+
+    # Chunk smaller than a cube pixel: use the pixel under its center.
+    px, py = (float(v) for v in cube.wcs.world_to_pixel(center_sky))
+    ix, iy = round(px), round(py)
+    if not (math.isfinite(px) and math.isfinite(py) and 0 <= ix < nx and 0 <= iy < ny):
+        raise SpectrumUnavailableError("This chunk falls outside the spectral cube.")
+    mask[iy, ix] = True
+    return mask
+
+
+def chunk_spectrum(
+    ra_deg: float, dec_deg: float, observation_date: date, size_deg: float, x: float, y: float
+) -> dict:
+    geometry = get_frame_geometry(ra_deg, dec_deg, observation_date, size_deg)
+    grid = chunk_grid(geometry)
+    row, col = chunk_at(x, y, grid)
+
+    xs, ys = chunk_corners_pixels(row, col, grid, geometry.shape)
+    corners_sky = geometry.wcs.pixel_to_world(xs, ys)
+    center_sky = geometry.wcs.pixel_to_world(xs.mean(), ys.mean())
+
+    cube = get_field_cube(ra_deg, dec_deg, size_deg)
+    mask = _chunk_pixel_mask(cube, corners_sky, center_sky)
+
+    with warnings.catch_warnings():
+        warnings.simplefilter("ignore", RuntimeWarning)  # all-NaN channels -> NaN
+        flux = np.nanmean(cube.data[:, mask], axis=1)
+    if not np.isfinite(flux).any():
+        raise SpectrumUnavailableError("The SPHEREx mosaic has no coverage for this chunk.")
+
+    order = np.argsort(cube.wavelength_um)
+    points = [
+        {
+            "wavelengthUm": round(float(cube.wavelength_um[i]), 5),
+            "bandwidthUm": round(float(cube.bandwidth_um[i]), 5),
+            "flux": float(flux[i]) if np.isfinite(flux[i]) else None,
+        }
+        for i in order
+    ]
+    return {
+        "chunk": {
+            "row": row,
+            "col": col,
+            "rows": grid.rows,
+            "cols": grid.cols,
+            "sizeArcsec": round(grid.chunk_arcsec, 2),
+            "bounds": {
+                "left": col / grid.cols,
+                "top": row / grid.rows,
+                "width": 1 / grid.cols,
+                "height": 1 / grid.rows,
+            },
+        },
+        "center": {
+            "ra": round(float(center_sky.ra.deg), 6),
+            "dec": round(float(center_sky.dec.deg), 6),
+        },
+        "pixelCount": int(mask.sum()),
+        "unit": cube.unit,
+        "source": SPECTRUM_SOURCE,
+        "points": points,
+    }
