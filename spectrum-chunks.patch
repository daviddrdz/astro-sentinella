+import { afterEach, describe, expect, it, vi } from "vitest";
+import {
+  buildSpectrumUrl,
+  fetchChunkSpectrum,
+  SpectrumRequestError,
+} from "./spectrumService";
+
+const FRAME_URL =
+  "/api/frames/image?ra=83.82&dec=-5.39&fieldSizeDeg=0.05&observationDate=2025-05-01&color=magma&bands=2";
+
+const SAMPLE_SPECTRUM = {
+  chunk: {
+    row: 1,
+    col: 2,
+    rows: 7,
+    cols: 7,
+    sizeArcsec: 25.5,
+    bounds: { left: 2 / 7, top: 1 / 7, width: 1 / 7, height: 1 / 7 },
+  },
+  center: { ra: 83.82, dec: -5.39 },
+  pixelCount: 4,
+  unit: "MJy/sr",
+  source: "SPHEREx DR1 HiPS cube",
+  points: [
+    { wavelengthUm: 0.75, bandwidthUm: 0.02, flux: 1.2 },
+    { wavelengthUm: 1.5, bandwidthUm: 0.03, flux: null },
+    { wavelengthUm: 3.3, bandwidthUm: 0.04, flux: 4.8 },
+  ],
+};
+
+describe("spectrumService", () => {
+  afterEach(() => {
+    vi.restoreAllMocks();
+  });
+
+  it("builds the request from the frame URL, dropping render-only params", () => {
+    const url = new URL(buildSpectrumUrl(FRAME_URL, 0.25, 0.5), "http://x");
+    expect(url.pathname).toBe("/api/frames/spectrum");
+    expect(Object.fromEntries(url.searchParams)).toEqual({
+      ra: "83.82",
+      dec: "-5.39",
+      fieldSizeDeg: "0.05",
+      observationDate: "2025-05-01",
+      x: "0.2500",
+      y: "0.5000",
+    });
+  });
+
+  it("returns a validated spectrum", async () => {
+    vi.spyOn(globalThis, "fetch").mockResolvedValue(
+      new Response(JSON.stringify(SAMPLE_SPECTRUM), { status: 200 })
+    );
+    const result = await fetchChunkSpectrum(FRAME_URL, 0.3, 0.2);
+    expect(result.points).toHaveLength(3);
+    expect(result.chunk.rows).toBe(7);
+  });
+
+  it("surfaces the backend error code", async () => {
+    vi.spyOn(globalThis, "fetch").mockResolvedValue(
+      new Response(
+        JSON.stringify({
+          error: { code: "spectrum_unavailable", message: "No coverage." },
+        }),
+        { status: 404 }
+      )
+    );
+    await expect(fetchChunkSpectrum(FRAME_URL, 0.3, 0.2)).rejects.toMatchObject(
+      { code: "spectrum_unavailable" }
+    );
+  });
+
+  it("rejects malformed payloads", async () => {
+    vi.spyOn(globalThis, "fetch").mockResolvedValue(
+      new Response(JSON.stringify({ points: "nope" }), { status: 200 })
+    );
+    await expect(
+      fetchChunkSpectrum(FRAME_URL, 0.3, 0.2)
+    ).rejects.toBeInstanceOf(SpectrumRequestError);
+  });
+});
diff --git a/frontend/src/services/spectrumService.ts b/frontend/src/services/spectrumService.ts
new file mode 100644
index 0000000..cf04a3e
--- /dev/null
+++ b/frontend/src/services/spectrumService.ts
@@ -0,0 +1,98 @@
+import { EXPLORER_CONFIG, SPECTRUM_FORMAT } from "../config/explorer";
+import type { ChunkSpectrum } from "../types/explorer";
+
+const FRAME_QUERY_KEYS = [
+  "ra",
+  "dec",
+  "fieldSizeDeg",
+  "observationDate",
+] as const;
+
+export class SpectrumRequestError extends Error {
+  constructor(
+    message: string,
+    readonly code: string
+  ) {
+    super(message);
+    this.name = "SpectrumRequestError";
+  }
+}
+
+function isFiniteNumber(value: unknown): value is number {
+  return typeof value === "number" && Number.isFinite(value);
+}
+
+function isChunkSpectrum(data: unknown): data is ChunkSpectrum {
+  if (typeof data !== "object" || data === null) {
+    return false;
+  }
+  const candidate = data as Partial<ChunkSpectrum>;
+  const chunk = candidate.chunk;
+  return (
+    typeof chunk === "object" &&
+    chunk !== null &&
+    isFiniteNumber(chunk.rows) &&
+    isFiniteNumber(chunk.cols) &&
+    typeof chunk.bounds === "object" &&
+    chunk.bounds !== null &&
+    isFiniteNumber(chunk.bounds.left) &&
+    isFiniteNumber(chunk.bounds.top) &&
+    typeof candidate.unit === "string" &&
+    Array.isArray(candidate.points) &&
+    candidate.points.every(
+      (point) =>
+        isFiniteNumber(point?.wavelengthUm) &&
+        (point.flux === null || isFiniteNumber(point.flux))
+    )
+  );
+}
+
+/**
+ * Builds the spectrum request from the frame's own image URL, so the chunk is
+ * resolved against exactly the cutout the user is looking at.
+ */
+export function buildSpectrumUrl(
+  frameImageUrl: string,
+  x: number,
+  y: number
+): string {
+  const frameUrl = new URL(frameImageUrl, window.location.origin);
+  const params = new URLSearchParams();
+  for (const key of FRAME_QUERY_KEYS) {
+    const value = frameUrl.searchParams.get(key);
+    if (value !== null) {
+      params.set(key, value);
+    }
+  }
+  params.set("x", x.toFixed(SPECTRUM_FORMAT.clickDecimals));
+  params.set("y", y.toFixed(SPECTRUM_FORMAT.clickDecimals));
+  return `${EXPLORER_CONFIG.spectrumEndpoint}?${params.toString()}`;
+}
+
+export async function fetchChunkSpectrum(
+  frameImageUrl: string,
+  x: number,
+  y: number,
+  signal?: AbortSignal
+): Promise<ChunkSpectrum> {
+  const response = await fetch(buildSpectrumUrl(frameImageUrl, x, y), {
+    signal,
+  });
+  const body: unknown = await response.json().catch(() => null);
+
+  if (!response.ok) {
+    const error = (body as { error?: { code?: string; message?: string } })
+      ?.error;
+    throw new SpectrumRequestError(
+      error?.message ?? `Spectrum request failed (${response.status}).`,
+      error?.code ?? "unknown"
+    );
+  }
+  if (!isChunkSpectrum(body)) {
+    throw new SpectrumRequestError(
+      "Unexpected spectrum response.",
+      "invalid_response"
+    );
+  }
+  return body;
+}
