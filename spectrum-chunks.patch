+import { describe, expect, it } from "vitest";
+import {
+  clamp01,
+  containedBox,
+  formatFlux,
+  formatTick,
+  niceStep,
+} from "./spectrum";
+
+describe("containedBox", () => {
+  it("letterboxes a square image inside a wide container", () => {
+    expect(
+      containedBox({ width: 400, height: 200 }, { width: 29, height: 29 })
+    ).toEqual({ left: 100, top: 0, width: 200, height: 200 });
+  });
+
+  it("pillarboxes a wide image inside a tall container", () => {
+    expect(
+      containedBox({ width: 100, height: 300 }, { width: 200, height: 100 })
+    ).toEqual({ left: 0, top: 125, width: 100, height: 50 });
+  });
+});
+
+describe("niceStep and formatting", () => {
+  it("picks 1-2-5 steps", () => {
+    expect(niceStep(10, 4)).toBe(2);
+    expect(niceStep(0.9, 4)).toBeCloseTo(0.2);
+    expect(niceStep(3, 4)).toBeCloseTo(1);
+    expect(niceStep(2.4, 4)).toBeCloseTo(0.5);
+  });
+
+  it("formats fluxes compactly", () => {
+    expect(formatFlux(1.23456)).toBe("1.23");
+    expect(formatFlux(0.0012)).toBe("1.20e-3");
+    expect(formatFlux(0)).toBe("0.00");
+    expect(formatTick(-0.5, 0.5)).toBe("-0.5");
+    expect(formatTick(2, 1)).toBe("2");
+    expect(formatTick(0.04, 0.02)).toBe("0.04");
+  });
+
+  it("clamps click fractions", () => {
+    expect(clamp01(-0.2)).toBe(0);
+    expect(clamp01(1.4)).toBe(1);
+    expect(clamp01(0.3)).toBe(0.3);
+  });
+});
diff --git a/frontend/src/utils/spectrum.ts b/frontend/src/utils/spectrum.ts
new file mode 100644
index 0000000..0ae5863
--- /dev/null
+++ b/frontend/src/utils/spectrum.ts
@@ -0,0 +1,57 @@
+import { SPECTRUM_FORMAT } from "../config/explorer";
+
+export interface Size {
+  width: number;
+  height: number;
+}
+
+export const HALF = 2;
+
+/** Box the image occupies inside its container under `object-contain`. */
+export function containedBox(container: Size, natural: Size) {
+  const scale = Math.min(
+    container.width / natural.width,
+    container.height / natural.height
+  );
+  const width = natural.width * scale;
+  const height = natural.height * scale;
+  return {
+    left: (container.width - width) / HALF,
+    top: (container.height - height) / HALF,
+    width,
+    height,
+  };
+}
+
+export const clamp01 = (value: number) => Math.min(1, Math.max(0, value));
+
+/** 1-2-5 style tick step for a span split into roughly `target` intervals. */
+export function niceStep(span: number, target: number): number {
+  const raw = span / target;
+  const magnitude = SPECTRUM_FORMAT.niceBase ** Math.floor(Math.log10(raw));
+  const residual = raw / magnitude;
+  const match = SPECTRUM_FORMAT.niceResiduals.find(
+    (entry) => residual >= entry.atLeast
+  );
+  return (match?.nice ?? 1) * magnitude;
+}
+
+export function formatFlux(value: number): string {
+  const abs = Math.abs(value);
+  if (
+    abs !== 0 &&
+    (abs < SPECTRUM_FORMAT.fluxSmallAbs || abs >= SPECTRUM_FORMAT.fluxLargeAbs)
+  ) {
+    return value.toExponential(SPECTRUM_FORMAT.fluxExpDigits);
+  }
+  return value.toPrecision(SPECTRUM_FORMAT.fluxSignificantDigits);
+}
+
+/** Tick label with just enough decimals for the tick step (0.5 -> "0.5"). */
+export function formatTick(value: number, step: number): string {
+  if (Math.abs(value) >= SPECTRUM_FORMAT.fluxLargeAbs) {
+    return value.toExponential(SPECTRUM_FORMAT.fluxExpDigits);
+  }
+  const decimals = Math.max(0, -Math.floor(Math.log10(step)));
+  return value.toFixed(decimals);
+}
